@app.route("/report/<int:student_id>")
def student_report(student_id):

    connection = get_db()

    student = connection.execute("""
        SELECT *
        FROM students
        WHERE id = ?
    """, (student_id,)).fetchone()

    if student is None:

        connection.close()

        return "Student not found", 404

    subjects = connection.execute("""
        SELECT *
        FROM subject_marks
        WHERE student_id = ?
        ORDER BY marks DESC
    """, (student_id,)).fetchall()

    if subjects:

        marks_list = [
            subject["marks"]
            for subject in subjects
        ]

        average = round(
            sum(marks_list)
            / len(marks_list),
            2
        )

        highest = max(marks_list)

        lowest = min(marks_list)

        passed = sum(
            1
            for mark in marks_list
            if mark >= 50
        )

        failed = (
            len(marks_list)
            - passed
        )

        overall_grade = calculate_grade(
            round(average)
        )

    else:

        average = 0
        highest = 0
        lowest = 0
        passed = 0
        failed = 0
        overall_grade = "F"

    connection.close()

    return render_template(

        "report.html",

        student=student,

        subjects=subjects,

        average=average,

        highest=highest,

        lowest=lowest,

        passed=passed,

        failed=failed,

        overall_grade=overall_grade

    )


