@app.route(
    "/delete/<int:student_id>",
    methods=["POST"]
)
def delete_student(student_id):

    connection = get_db()

    student = connection.execute("""
        SELECT name
        FROM students
        WHERE id = ?
    """, (student_id,)).fetchone()

    if student is None:

        connection.close()

        return redirect("/")

    connection.execute(
        "DELETE FROM students WHERE id = ?",
        (student_id,)
    )

    connection.commit()
    connection.close()

    return redirect("/")


# ==========================================
# EDIT STUDENT
# ==========================================

@app.route(
    "/edit/<int:student_id>",
    methods=["GET", "POST"]
)
def edit_student(student_id):

    connection = get_db()

    student = connection.execute("""
        SELECT *
        FROM students
        WHERE id = ?
    """, (student_id,)).fetchone()

    if student is None:

        connection.close()

        return "Student not found", 404

    if request.method == "POST":

        name = request.form.get(
            "name",
            ""
        ).strip()

        subjects = request.form.getlist(
            "subject"
        )

        marks_values = request.form.getlist(
            "marks"
        )

        valid_name, name_error = validate_name(name)

        if not valid_name:

            connection.close()

            return name_error

        valid_subjects = []
        validation_error = ""

        for subject, marks in zip(
            subjects,
            marks_values
        ):

            subject = subject.strip()
            marks = marks.strip()

            if not subject and not marks:
                continue

            valid_subject, subject_error = validate_subject(
                subject
            )

            if not valid_subject:

                validation_error = subject_error
                break

            valid_marks, marks_error = validate_marks(
                marks
            )

            if not valid_marks:

                validation_error = marks_error
                break

            valid_subjects.append(
                (subject, int(marks))
            )

        if validation_error:

            connection.close()

            return validation_error

        if not valid_subjects:

            connection.close()

            return (
                "Please add at least "
                "one valid subject."
            )

        subject_names = [
            item[0]
            for item in valid_subjects
        ]

        subjects_valid, subject_error = (
            validate_subject_list(
                subject_names
            )
        )

        if not subjects_valid:

            connection.close()

            return subject_error

        # Check whether another student
        # already has this name

        duplicate_student = connection.execute(
            """
            SELECT id
            FROM students
            WHERE LOWER(name) = LOWER(?)
            AND id != ?
            """,
            (
                name,
                student_id
            )
        ).fetchone()

        if duplicate_student:

            connection.close()

            return (
                "Another student already "
                "uses this name."
            )

        try:

            connection.execute("""
                UPDATE students
                SET name = ?
                WHERE id = ?
            """, (
                name,
                student_id
            ))

            connection.execute("""
                DELETE FROM subject_marks
                WHERE student_id = ?
            """, (student_id,))

            for subject, marks in valid_subjects:

                grade = calculate_grade(marks)

                connection.execute("""
                    INSERT INTO subject_marks
                    (student_id, subject, marks, grade)
                    VALUES (?, ?, ?, ?)
                """, (
                    student_id,
                    subject,
                    marks,
                    grade
                ))

            connection.commit()
            connection.close()

            return redirect("/")

        except sqlite3.IntegrityError:

            connection.rollback()
            connection.close()

            return (
                "Unable to update the student."
            )

    subjects = connection.execute("""
        SELECT *
        FROM subject_marks
        WHERE student_id = ?
        ORDER BY id
    """, (student_id,)).fetchall()

    connection.close()

    return render_template(

        "edit.html",

        student=student,

        subjects=subjects

    )


